            "sub": "fake-owner-ivoryglow",
            "email": "owner@ivoryglow.com",
            "email_verified": true,
            "hd": "ivoryglow.com",
            "amr": ["mfa"]
          }
        },
        {
          "requestParam": "username",
          "match": "ops@ivoryglow.com",
          "claims": {
            "sub": "fake-ops-ivoryglow",
