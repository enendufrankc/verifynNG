            "email_verified": true,
            "hd": "ivoryglow.com"
          }
        },
        {
          "requestParam": "username",
          "match": "newhire@ivoryglow.com",
          "claims": {
            "sub": "fake-newhire-ivoryglow",
            "email": "newhire@ivoryglow.com",
            "email_verified": true,
            "hd": "ivoryglow.com"
          }
        },
        {
          "requestParam": "username",
          "match": "newhire2@ivoryglow.com",
          "claims": {
            "sub": "fake-newhire2-ivoryglow",
            "email": "newhire2@ivoryglow.com",
            "email_verified": true,
            "hd": "ivoryglow.com"
          }
        },
        {
          "requestParam": "username",
