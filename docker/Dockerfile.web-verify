FROM node:26-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web-verify/package.json apps/web-verify/
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/

RUN pnpm install --frozen-lockfile

COPY apps/web-verify/ apps/web-verify/
COPY packages/config/ packages/config/
COPY packages/core/ packages/core/
COPY packages/ui/ packages/ui/
COPY tsconfig.base.json ./

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time (used
# by lib/beacon.ts) — the browser-reachable URL must be supplied here, not
# read at runtime. The container-internal `http://api:4000` set on the
# runner stage below (as API_INTERNAL_URL) is what lib/api.ts's server-only
# fetches use instead.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @verifynng/config build && pnpm --filter @verifynng/core build && pnpm --filter @verifyng/ui build && pnpm --filter @verifynng/web-verify build

# ── Production stage ───────────────────────────────────────────
FROM node:26-alpine AS runner
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 appuser && \
    apk add --no-cache curl
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/apps/web-verify/.next/standalone ./
COPY --from=builder /app/apps/web-verify/.next/static ./apps/web-verify/.next/static
COPY --from=builder /app/apps/web-verify/public ./apps/web-verify/public

USER appuser
EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web-verify/server.js"]
