FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web-admin/package.json apps/web-admin/
COPY packages/config/package.json packages/config/
COPY packages/page-schema/package.json packages/page-schema/
COPY packages/ui/package.json packages/ui/

RUN pnpm install --frozen-lockfile

COPY apps/web-admin/ apps/web-admin/
COPY packages/config/ packages/config/
COPY packages/page-schema/ packages/page-schema/
COPY packages/ui/ packages/ui/
COPY tsconfig.base.json ./

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, so the
# browser-reachable URL must be supplied here as a build ARG — the
# container-internal `http://api:4000` set at runtime below is only ever
# seen by server-side code (Route Handlers), never by code already compiled
# into the client JS. NEXT_PUBLIC_VERIFY_URL (E10) is the same story — the
# page-builder's live preview iframe (client-side) needs the browser-facing
# web-verify origin.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_VERIFY_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_VERIFY_URL=$NEXT_PUBLIC_VERIFY_URL

RUN pnpm --filter @verifynng/config build && pnpm --filter @verifynng/page-schema build && pnpm --filter @verifyng/ui build && pnpm --filter @verifynng/web-admin build

# ── Production stage ───────────────────────────────────────────
FROM node:22-alpine AS runner
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 appuser && \
    apk add --no-cache curl
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/apps/web-admin/.next/standalone ./
COPY --from=builder /app/apps/web-admin/.next/static ./apps/web-admin/.next/static

USER appuser
EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web-admin/server.js"]
