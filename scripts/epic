#!/usr/bin/env bash
# Epic helper: start a worktree for an epic and print the agent prompt; show status.
#   scripts/epic start E06      → creates ../verifynNG-E06 on branch epic/E06-<slug>, writes its .env (own ports), prints prompt
#   scripts/epic ports E06      → print the host ports this epic's worktree uses
#   scripts/epic status         → all epics: issue, state, assignee, branch
#   scripts/epic handoff E06    → snapshot+push WIP, post handoff summary on the issue, print resume prompt
#   scripts/epic done E06       → removes the worktree (after its issue is closed and branch merged)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="enendufrankc/verifynNG"
cmd="${1:-}"; id="${2:-}"

file_for() { ls "$ROOT/docs/epics/$1-"*.md 2>/dev/null | head -1; }
slug_for() { basename "$(file_for "$1")" .md | sed "s/^$1-//"; }
issue_for() { grep -oE "issues/[0-9]+" "$(file_for "$1")" | head -1 | cut -d/ -f2; }
num_for() { echo "$1" | sed 's/^E0*//'; }

# Each worktree gets its own compose project and host ports: base + 103*N (N = epic number).
# 103 is chosen so no two epics' shifted ports collide across the base port set.
write_env() {
  local wt="$1" eid="$2" n off
  n="$(num_for "$eid")"; off=$((103 * n))
  local pg=$((5432+off)) redis=$((6379+off)) minio=$((9000+off)) minioc=$((9001+off)) mpui=$((8025+off)) mpsmtp=$((1025+off))
  local sms=$((4101+off)) pay=$((4102+off)) geo=$((4103+off)) api=$((4000+off)) wv=$((3000+off)) wa=$((3001+off))
  local proj="verifynng-$(echo "$eid" | tr 'A-Z' 'a-z')"
  local body
  body="$(cat <<EOF
# Written by scripts/epic start $eid — per-worktree compose project + ports (offset $off). Not committed.
COMPOSE_PROJECT_NAME=$proj
POSTGRES_PORT=$pg
REDIS_PORT=$redis
MINIO_PORT=$minio
MINIO_CONSOLE_PORT=$minioc
MAILPIT_UI_PORT=$mpui
MAILPIT_SMTP_PORT=$mpsmtp
FAKE_SMS_PORT=$sms
FAKE_PAY_PORT=$pay
FAKE_GEO_PORT=$geo
API_HOST_PORT=$api
WEB_VERIFY_PORT=$wv
WEB_ADMIN_PORT=$wa
# Host-side tools (pnpm db:*, tests) reach the containers through the offset ports:
DATABASE_URL=postgresql://postgres:postgres@localhost:$pg/verifynng?schema=public
REDIS_URL=redis://localhost:$redis
S3_ENDPOINT=http://localhost:$minio
SMTP_PORT=$mpsmtp
NEXT_PUBLIC_API_URL=http://localhost:$api
EOF
)"
  printf '%s\n' "$body" > "$wt/.env"
  printf '%s\n' "$body" > "$wt/docker/.env"   # compose reads .env from the compose file's directory
}

print_ports() {
  local wt="$1"
  [[ -f "$wt/.env" ]] || { echo "no .env in $wt"; return 1; }
  echo "Compose project: $(grep COMPOSE_PROJECT_NAME "$wt/.env" | cut -d= -f2)"
  printf "  %-14s http://localhost:%s\n" "API"        "$(grep ^API_HOST_PORT "$wt/.env" | cut -d= -f2)"
  printf "  %-14s http://localhost:%s\n" "web-verify" "$(grep ^WEB_VERIFY_PORT "$wt/.env" | cut -d= -f2)"
  printf "  %-14s http://localhost:%s\n" "web-admin"  "$(grep ^WEB_ADMIN_PORT "$wt/.env" | cut -d= -f2)"
  printf "  %-14s http://localhost:%s\n" "Mailpit"    "$(grep ^MAILPIT_UI_PORT "$wt/.env" | cut -d= -f2)"
  printf "  %-14s http://localhost:%s\n" "MinIO"      "$(grep ^MINIO_CONSOLE_PORT "$wt/.env" | cut -d= -f2)"
  printf "  %-14s localhost:%s\n"        "Postgres"   "$(grep ^POSTGRES_PORT "$wt/.env" | cut -d= -f2)"
  printf "  %-14s localhost:%s\n"        "Redis"      "$(grep ^REDIS_PORT "$wt/.env" | cut -d= -f2)"
}

case "$cmd" in
  start)
    [[ -n "$id" ]] || { echo "usage: scripts/epic start EXX"; exit 1; }
    f="$(file_for "$id")"; [[ -n "$f" ]] || { echo "no epic file for $id"; exit 1; }
    slug="$(slug_for "$id")"; num="$(issue_for "$id")"
    wt="$ROOT/../verifynNG-$id"; br="epic/$id-$slug"
    git -C "$ROOT" fetch -q origin main
    if [[ -d "$wt" ]]; then echo "worktree exists: $wt"; else
      git -C "$ROOT" worktree add -q "$wt" -b "$br" origin/main && echo "created $wt on $br"
    fi
    write_env "$wt" "$id"
    cat <<EOF

────────────────────────────────────────────────────────────────
Open a terminal in:  $wt
Start your agent there and paste this:
────────────────────────────────────────────────────────────────
You own epic $id in this repo. Read AGENTS.md (especially "Definition of done"),
docs/epics/README.md, docs/epics/$(basename "$f"), and your section of
docs/epics/CROSS-EPIC-REQUESTS.md.
Claim GitHub issue #$num: assign yourself and set Owner/Status in the epic file via a small PR.
Work only inside your owned paths; follow the hot-spot rules for shared files; open small PRs
into main; keep the pre-push checks green; tick the issue checklist as tasks merge. The epic is
done only when every acceptance criterion is demonstrated against docker compose up, evidence
is pasted in the issue, the PR is merged and the issue closed.
This worktree has its own Docker ports (see .env; run scripts/epic ports $id). Use them —
do not assume 3000/3001/4000/5432.
Branch: $br
────────────────────────────────────────────────────────────────
EOF
    print_ports "$wt"
    ;;
  ports)
    [[ -n "$id" ]] || { echo "usage: scripts/epic ports EXX"; exit 1; }
    print_ports "$ROOT/../verifynNG-$id"
    ;;
  handoff)
    # Snapshot an agent's in-flight work so a different agent can take over.
    [[ -n "$id" ]] || { echo "usage: scripts/epic handoff EXX"; exit 1; }
    f="$(file_for "$id")"; num="$(issue_for "$id")"; wt="$ROOT/../verifynNG-$id"
    [[ -d "$wt" ]] || { echo "no worktree at $wt"; exit 1; }
    br="$(git -C "$wt" branch --show-current)"
    unc="$(git -C "$wt" status --short | wc -l | tr -d ' ')"
    if [[ "$unc" != "0" ]]; then
      # WIP may not lint or build yet; the snapshot is a save-point, not a PR. Hooks are skipped
      # deliberately here and only here — the resuming agent must make it green before opening a PR.
      git -C "$wt" add -A
      git -C "$wt" -c user.name="epic-handoff" -c user.email="handoff@local" commit -q --no-verify \
        -m "wip($id): handoff snapshot — uncommitted work at agent stop (may not build)"
    fi
    git -C "$wt" push -q --no-verify -u origin "$br" 2>/dev/null || git -C "$wt" push -q --no-verify --force-with-lease -u origin "$br"
    ahead="$(git -C "$wt" rev-list --count origin/main..HEAD)"
    plan="$( { ls "$wt"/docs/superpowers/plans/*"$(echo "$id" | tr 'A-Z' 'a-z')"* 2>/dev/null || true; } | head -1 | sed "s#^$wt/##")"
    summary="$(cat <<EOF
## Handoff snapshot — $(date -u +%Y-%m-%dT%H:%MZ)

Previous agent stopped mid-flight. State saved on branch \`$br\` ($ahead commits ahead of \`main\`, pushed).
$( [[ "$unc" != "0" ]] && echo "The last commit is a **WIP snapshot of $unc uncommitted files** (hooks skipped) — it may not lint/build." )

### Commits since main
\`\`\`
$(git -C "$wt" log --oneline origin/main..HEAD)
\`\`\`

### Files touched vs main
\`\`\`
$(git -C "$wt" diff --stat origin/main..HEAD | tail -25)
\`\`\`

### Epic checklist (unticked = remaining)
$(grep -E "^- \[[ x]\] (T|AC)" "$wt/docs/epics/$(basename "$f")" | head -60)

$( [[ -n "$plan" ]] && echo "### Agent's plan doc" && echo "\`$plan\`" )

### For the next agent
1. \`git log origin/main..HEAD\` and \`git show --stat HEAD\` — see what exists.
2. \`pnpm install\`, then \`pnpm lint && pnpm typecheck && pnpm test && pnpm build\` — make it green first.
3. Reconcile the WIP against the checklist above; tick what is actually done, finish the rest per the epic file.
EOF
)"
    printf '%s\n' "$summary" | gh issue comment "$num" -R "$REPO" -F - >/dev/null && echo "handoff posted on issue #$num; branch $br pushed ($ahead commits)"
    cat <<EOF

────────────────────────────────────────────────────────────────
Resume prompt for the NEW agent — open a terminal in: $wt
────────────────────────────────────────────────────────────────
You are taking over epic $id mid-flight from another agent that stopped. Read AGENTS.md
(especially "Definition of done"), docs/epics/README.md, docs/epics/$(basename "$f"), your
section of docs/epics/CROSS-EPIC-REQUESTS.md, and the latest "Handoff snapshot" comment on
GitHub issue #$num — it lists what exists on this branch.
Start by inspecting the work: git log origin/main..HEAD and git show --stat HEAD. The last
commit may be a WIP snapshot that does not build. Run pnpm install, then make lint, typecheck,
test and build green before anything else. Then reconcile the WIP against the epic checklist,
tick what is truly done in the epic file, and continue the remaining tasks in order with
small PRs into main. Rebase on main before each PR. Use this worktree's Docker ports (.env;
scripts/epic ports $id). Branch: $br.
────────────────────────────────────────────────────────────────
EOF
    ;;
  status)
    printf "%-4s %-6s %-12s %-18s %s\n" ID ISSUE STATE ASSIGNEE TITLE
    for f in "$ROOT"/docs/epics/E*.md; do
      eid="$(basename "$f" | cut -c1-3)"; num="$(grep -oE "issues/[0-9]+" "$f" | head -1 | cut -d/ -f2)"
      [[ -n "$num" ]] || continue
      gh issue view "$num" -R "$REPO" --json state,assignees,title \
        --jq "\"$eid  #$num  \" + .state + \"  \" + ((.assignees|map(.login)|join(\",\"))|if .==\"\" then \"-\" else . end) + \"  \" + .title" 2>/dev/null
    done
    echo; echo "Worktrees:"; git -C "$ROOT" worktree list
    ;;
  done)
    [[ -n "$id" ]] || { echo "usage: scripts/epic done EXX"; exit 1; }
    wt="$ROOT/../verifynNG-$id"
    [[ -f "$wt/docker/compose.yml" ]] && (cd "$wt" && docker compose -f docker/compose.yml down -v --remove-orphans >/dev/null 2>&1 || true)
    git -C "$ROOT" worktree remove --force "$wt" && echo "removed worktree for $id"
    ;;
  *) sed -n '2,8p' "$0";;
esac
