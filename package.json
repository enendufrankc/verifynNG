{
  "name": "verifynng",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:isolation": "vitest run --config tests/vitest.config.ts",
    "load:verify": "docker compose -f docker/compose.yml --profile load run --rm k6 /scripts/verify.js",
    "db:migrate": "pnpm --filter @verifynng/db db:migrate",
    "db:reset": "pnpm --filter @verifynng/db db:reset",
    "db:seed": "pnpm --filter @verifynng/db db:seed",
    "db:seed:realistic": "pnpm --filter @verifynng/db db:seed:realistic",
    "test:smoke": "pnpm test:e2e --grep @smoke",
    "test:contract": "echo 'TODO(E16): contract tests pending E16 public API'",
    "seed:lint": "echo 'TODO(E21): seed privacy scanner — placeholder'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@playwright/test": "1.62.1",
    "@prisma/client": "6.19.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "depcheck": "1.4.7",
    "dotenv": "17.4.2",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "turbo": "2.10.12",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "argon2": "^0.45.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.6",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4"
  }
}
