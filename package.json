{
  "name": "verifynng",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && tsx scripts/check-token-drift.ts",
    "check:tokens": "tsx scripts/check-token-drift.ts",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:isolation": "vitest run --config tests/vitest.config.ts",
    "load:verify": "docker compose -f docker/compose.yml --profile load run --rm k6 /scripts/verify.js",
    "db:migrate": "pnpm --filter @verifynng/db db:migrate",
    "db:reset": "pnpm --filter @verifynng/db db:reset",
    "db:seed": "pnpm --filter @verifynng/db db:seed",
    "db:seed:realistic": "pnpm --filter @verifynng/db db:seed:realistic",
    "secrets:rotate-core-key": "node tools/scripts/secrets/rotate-core-key.mjs",
    "test:smoke": "pnpm test:e2e --grep @smoke",
    "test:contract": "echo 'TODO(E16): contract tests pending E16 public API'",
    "seed:lint": "echo 'TODO(E21): seed privacy scanner — placeholder'",
    "notifications:preview": "pnpm --filter @verifynng/api notifications:preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@playwright/test": "1.62.1",
    "@prisma/client": "7.10.0",
    "depcheck": "1.4.7",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "tsx": "^4.23.12",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  }
}
