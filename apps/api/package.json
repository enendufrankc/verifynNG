{
  "name": "@verifynng/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "notifications:preview": "email dev --dir src/modules/notifications/templates/preview --port 4110",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "mint-bench": "tsx scripts/mint-bench.ts",
    "jobs:run": "tsx scripts/jobs-run.ts",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs && git diff --exit-code -- openapi/verify.v1.json",
    "public-api:openapi:generate": "node scripts/generate-public-api-openapi.mjs",
    "public-api:openapi:check": "node scripts/generate-public-api-openapi.mjs && git diff --exit-code -- ../../packages/sdk/openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.879.0",
    "@aws-sdk/s3-request-presigner": "3.879.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "11.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@react-email/components": "^1.0.12",
    "@react-email/ui": "^6.9.3",
    "@react-pdf/renderer": "^4.9.0",
    "@scalar/nestjs-api-reference": "^1.2.17",

    "@verifynng/config": "workspace:*",
    "@verifynng/core": "workspace:*",
    "@verifynng/db": "workspace:*",
    "archiver": "7.0.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "file-type": "^21.0.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "ioredis": "5.7.0",
    "nodemailer": "^9.0.6",

    "openid-client": "^6.8.7",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^6.9.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.34.4",
    "ua-parser-js": "^2.0.3",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.2.3",
    "@types/archiver": "6.0.2",
    "@types/express": "5.0.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "10.0.0",
    "dotenv": "17.4.2",
    "exifr": "^7.1.3",
    "msw": "^2.6.0",
    "supertest": "^7.1.4",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
