{
  "name": "@verifynng/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "mint-bench": "tsx scripts/mint-bench.ts",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs && git diff --exit-code -- openapi/verify.v1.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "11.1.1",
    "@react-pdf/renderer": "^4.9.0",
    "@verifynng/config": "workspace:*",
    "@verifynng/core": "workspace:*",
    "@verifynng/db": "workspace:*",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "5.7.0",
    "nodemailer": "^9.0.6",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ua-parser-js": "^2.0.3",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.2.3",
    "@types/archiver": "^8.0.0",
    "@types/express": "5.0.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.9",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "10.0.0",
    "dotenv": "17.4.2",
    "supertest": "^7.1.4",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
