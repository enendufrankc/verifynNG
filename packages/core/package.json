{
  "name": "@verifynng/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage",
    "test:nocov": "vitest run",
    "depcheck": "npx depcheck --ignores=@types/node,tsup,typescript,vitest,@vitest/coverage-istanbul,@vitest/coverage-v8,fast-check,eslint,prettier,depcheck"
  },
  "devDependencies": {
    "@types/node": "26",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/coverage-istanbul": "4.1.11",
    "fast-check": "4.9.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
