{
  "name": "@verifynng/db",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/prisma-with-env.cjs migrate deploy",
    "db:reset": "node scripts/prisma-with-env.cjs migrate reset --force",
    "db:seed": "node scripts/prisma-with-env.cjs db seed",
    "db:seed:realistic": "tsx prisma/seed/realistic/index.ts",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.879.0",
    "@prisma/client": "6.19.3",
    "@verifynng/config": "workspace:*",
    "@verifynng/core": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
